{
  "name": "newmarket",
  "version": "1.0.0",
  "description": "Multi-Vendor Student Storefront Platform with persistent orders and Paystack payments",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"server,client\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "prisma db push && node server/index.js",
    "start": "npx prisma migrate deploy && node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "framer-motion": "^12.4.10",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.475.0",
    "multer": "^2.4.0",
    "postcss": "^8.5.3",
    "prisma": "^6.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.2.0"
  },
  "keywords": [
    "multi-vendor",
    "ecommerce",
    "campus-marketplace",
    "react",
    "tailwind",
    "express",
    "prisma"
  ],
  "author": "Student Team",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
