datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  BUYER
  VENDOR
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  READY_FOR_PICKUP
  DELIVERED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         Role     @default(BUYER)
  campus       String?
  hostel       String?
  createdAt    DateTime @default(now())

  stores Stores[]
  orders Orders[]
}

model Stores {
  id          String   @id @default(uuid())
  vendorId    String
  storeName   String
  description String?
  category    String?
  tagline     String?
  avatar      String?
  banner      String?
  location    String?
  whatsApp    String?
  createdAt   DateTime @default(now())

  vendor     User         @relation(fields: [vendorId], references: [id])
  products   Products[]
  orderItems OrderItems[]
}

model Products {
  id            String   @id @default(uuid())
  storeId       String
  name          String
  description   String?
  price         Float
  originalPrice Float?
  stockQuantity Int      @default(0)
  imageUrl      String?
  category      String?
  isBestseller  Boolean  @default(false)
  rating        Float    @default(0)
  reviews       Int      @default(0)
  badge         String?
  createdAt     DateTime @default(now())

  store      Stores       @relation(fields: [storeId], references: [id])
  orderItems OrderItems[]
}

model Orders {
  id            String   @id @default(uuid())
  buyerId       String
  totalAmount   Float
  paymentStatus String   @default("PENDING")
  paymentReference String? @unique
  paymentProvider  String?
  buyerHostel   String?
  campus        String?
  createdAt     DateTime @default(now())

  buyer      User         @relation(fields: [buyerId], references: [id])
  orderItems OrderItems[]
}

model OrderItems {
  id        String      @id @default(uuid())
  orderId   String
  storeId   String
  productId String
  quantity  Int
  unitPrice Float
  status    OrderStatus @default(PENDING)

  order   Orders   @relation(fields: [orderId], references: [id])
  store   Stores   @relation(fields: [storeId], references: [id])
  product Products @relation(fields: [productId], references: [id])
}
